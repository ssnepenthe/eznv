#!/usr/bin/env php
<?php

use Eznv\Application;
use Eznv\Command\AdoptCommand;
use Eznv\Command\ComposerCommand;
use Eznv\Command\DestroyCommand;
use Eznv\Command\ForCommand;
use Eznv\Command\InfoCommand;
use Eznv\Command\InitCommand;
use Eznv\Command\ListCommand;
use Eznv\Command\LogsCommand;
use Eznv\Command\PostUpdateCommand;
use Eznv\Command\PruneCommand;
use Eznv\Command\ServeCommand;
use Eznv\Command\ShellCommand;
use Eznv\Command\WpCommand;
use Eznv\Environment;
use Eznv\Eznv;
use Eznv\Project;
use Eznv\Support;

$autoloader = $GLOBALS['_composer_autoload_path'] ?? __DIR__ . '/../vendor/autoload.php';

if (! file_exists($autoloader)) {
    echo 'Autoloader not found. Please run "composer install".' . PHP_EOL;
    exit(1);
}

require $autoloader;

$eznv = Eznv::instance();
$firstRun = ! is_dir($eznv->baseDirectory);

Support::ensureDirectoryExists($eznv->baseDirectory);

if ($firstRun) {
    // We only want to create this file if the user has never used eznv before because we will use its absence later as
    // an indicator that the user may need to run the post-update command.
    $eznv->flushEznvJson();
}

// Always allow symfony/console default commands - running with no command is the same as running the help command.
// Doesn't account for running eznv commands with the --help flag, but that's probably fine...
$isBuiltinCommand = 1 === count($argv) || count($argv) >= 2 && in_array($argv[1], ['_complete', 'completion', 'help', 'list'], true);

// Init command will always be up-to-date and post-update command is required to get everything in working order after updating.
$canBypassUpdate = count($argv) >= 2 && in_array($argv[1], ['init', 'post-update'], true);

if (! $isBuiltinCommand && ! $canBypassUpdate && $eznv->isUpdateRequired()) {
    echo "A recent update introduced breaking changes. Please run '{$argv[0]} post-update' to ensure your existing environments are up-to-date." . PHP_EOL;
    exit(1);
}

Environment::resolveEnvironmentDirectoryUsing(fn (Project $project) => $eznv->path($project->hash));

$application = new Application;
$application->addCommands([
    new AdoptCommand,
    new ComposerCommand,
    new DestroyCommand,
    new ForCommand,
    new InfoCommand,
    new InitCommand,
    new ListCommand,
    new LogsCommand,
    new PostUpdateCommand,
    new PruneCommand,
    new ServeCommand,
    new ShellCommand,
    new WpCommand,
]);
$application->run();
