{
    "name": "ssnepenthe/eznv",
    "description": "A command-line tool for managing WordPress development environments using SQLite and WP-CLI",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "symfony/console": "^8.0",
        "symfony/process": "^8.0",
        "symfony/filesystem": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "symfony/var-dumper": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Eznv\\": "src/"
        }
    },
    "bin": [
        "bin/eznv"
    ]
}
